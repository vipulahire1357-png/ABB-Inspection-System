# ===== Abby API (required) =====
ABBY_API_KEY=paste_your_abby_api_key_here

# ===== Abby endpoint (verify at https://api.abby.abb.com/documentation/) =====
ABBY_BASE_URL=https://api.abby.abb.com
ABBY_CHAT_PATH=/v1/chat/completions
ABBY_AUTH_HEADER=Authorization
ABBY_AUTH_SCHEME=Bearer
ABBY_MODEL=gemini-3.8-flash

# ===== Optional tuning =====
ABBY_MAX_CONCURRENCY=3
ABBY_MAX_RETRIES=3
ABBY_MAX_OUTPUT_TOKENS=4096
ABBY_TEMPERATURE=0
ABBY_TIMEOUT_S=120
ABBY_JSON_MODE=true
ABBY_IMAGE_DETAIL=high
ABBY_VERIFY_SSL=true
MAX_LONG_SIDE=2048
JPEG_QUALITY=88
